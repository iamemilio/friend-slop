[ext_resource type="PackedScene" uid="uid://cd4v6kvl3kiuq" path="res://scenes/ui/lobby_panel.tscn" id="3_lobby"]
[ext_resource type="PackedScene" uid="uid://csettingspanel001" path="res://scenes/ui/settings_panel.tscn" id="4_settings"]
