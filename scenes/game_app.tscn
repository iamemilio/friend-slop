[ext_resource type="Script" path="res://scripts/voice/mic_capture_listener.gd" id="9_listener"]
[ext_resource type="Script" path="res://scripts/voice/proximity_chat_settings.gd" id="10_prox"]

[sub_resource type="Resource" id="ProxLobby"]
script = ExtResource("10_prox")
enabled = false

[sub_resource type="Resource" id="ProxMatch"]
script = ExtResource("10_prox")
enabled = true
full_volume_m = 8.0
max_range_m = 40.0
max_volume_db = 0.0
min_volume_db = -40.0

[node name="GameApp" type="Node"]
script = ExtResource("1_app")

[node name="MicCaptureBroker" type="Node" parent="."]
script = ExtResource("8_broker")

[node name="Mic" type="AudioStreamPlayer" parent="MicCaptureBroker"]
bus = &"MicCapture"

[node name="VoiceEngine" type="Node" parent="."]
script = ExtResource("5_engine")

[node name="Peers" type="Node" parent="VoiceEngine"]

[node name="States" type="Node" parent="."]

[node name="MainMenu" parent="States" instance=ExtResource("2_menu")]

[node name="Lobby" type="Control" parent="States"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VoiceSession" type="Node" parent="States/Lobby"]
script = ExtResource("6_voice")
open_mic = true

[node name="Listeners" type="Node" parent="States/Lobby/VoiceSession"]

[node name="Chat" type="Node" parent="States/Lobby/VoiceSession/Listeners"]
script = ExtResource("9_listener")
service = 0
